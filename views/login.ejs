<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Login - Ajaia Portal</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-gray-100 flex items-center justify-center h-screen">
  <div class="bg-white p-8 rounded shadow-md w-96">
    <h2 class="text-2xl font-bold mb-4 text-center">Candidate Login</h2>
    <% if (error) { %>
      <p class="text-red-500 text-sm mb-4"><%= error %></p>
    <% } %>
    <form action="/auth/login" method="POST">
      <div class="mb-4">
        <label class="block text-gray-700 text-sm font-bold mb-2">Email Address</label>
        <input type="email" name="email" required placeholder="alice@ajaia.test" class="w-full p-2 border rounded">
      </div>
      <div class="mb-6">
        <label class="block text-gray-700 text-sm font-bold mb-2">Password</label>
        <input type="password" name="password" required placeholder="password123" class="w-full p-2 border rounded">
      </div>
      <button type="submit" class="w-full bg-blue-600 text-white p-2 rounded hover:bg-blue-700">Login / Seed User</button>
    </form>
    <p class="text-xs text-gray-500 mt-4 text-center">Tip: Use <b>alice@ajaia.test</b> or <b>bob@ajaia.test</b> with password <b>password123</b>.</p>
  </div>
</body>
</html>