<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= doc.title %> - Editor</title>

  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.snow.css" rel="stylesheet">
</head>

<body class="bg-gray-50">

  <nav class="bg-white shadow p-4 flex justify-between items-center px-8">

    <div class="flex items-center space-x-4">
      <a href="/documents" class="text-gray-600 hover:text-black">
        &larr; Back
      </a>

      <input
        type="text"
        id="docTitle"
        value="<%= doc.title %>"
        class="text-lg font-bold border-b border-transparent hover:border-gray-300 focus:border-blue-500 outline-none px-1"
      >
    </div>

    <div class="flex items-center space-x-4">
      <span id="saveStatus" class="text-xs text-gray-500">
        All changes saved
      </span>

      <button
        id="saveBtn"
        class="bg-blue-600 text-white px-4 py-1.5 rounded text-sm hover:bg-blue-700"
      >
        Save
      </button>
    </div>

  </nav>

  <div class="max-w-4xl mx-auto mt-6 grid grid-cols-3 gap-6">

    <div class="col-span-2 bg-white rounded shadow p-4">

      <div id="editor" style="height:500px;">
        <%- doc.content %>
      </div>

    </div>

    <% if (isOwner) { %>

      <div class="bg-white rounded shadow p-4 h-fit">

        <h3 class="font-bold text-gray-700 mb-2">
          Share Document
        </h3>

        <form action="/documents/<%= doc._id %>/share" method="POST">

          <input
            type="email"
            name="email"
            required
            placeholder="colleague@ajaia.test"
            class="w-full p-2 border rounded text-sm mb-2"
          >

          <button
            type="submit"
            class="w-full bg-green-600 text-white py-1.5 rounded text-sm hover:bg-green-700"
          >
            Grant Access
          </button>

        </form>

      </div>

    <% } %>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.min.js"></script>

  <script>

    const quill = new Quill('#editor', {
      theme: 'snow',
      modules: {
        toolbar: [
          [{ header: [1, 2, 3, false] }],
          ['bold', 'italic', 'underline'],
          [{ list: 'ordered' }, { list: 'bullet' }]
        ]
      }
    });

    const saveBtn = document.getElementById('saveBtn');
    const docTitle = document.getElementById('docTitle');
    const saveStatus = document.getElementById('saveStatus');

    // -------------------------------
    // Show "Unsaved changes"
    // -------------------------------

    quill.on('text-change', function () {
      saveStatus.textContent = 'Unsaved changes';
    });

    docTitle.addEventListener('input', function () {
      saveStatus.textContent = 'Unsaved changes';
    });

    // -------------------------------
    // Save document
    // -------------------------------

    saveBtn.addEventListener('click', async function () {

      try {

        saveStatus.textContent = 'Saving...';

        const response = await fetch('/documents/<%= doc._id %>/update', {

          method: 'POST',

          headers: {
            'Content-Type': 'application/json'
          },

          body: JSON.stringify({

            title: docTitle.value.trim() || 'Untitled Document',

            content: quill.root.innerHTML

          })

        });

        const result = await response.json();

        if (response.ok && result.success) {

          saveStatus.textContent = 'All changes saved';

        } else {

          saveStatus.textContent = 'Error saving';

          console.error(result);

        }

      } catch (err) {

        saveStatus.textContent = 'Error saving';

        console.error(err);

      }

    });

  </script>

</body>
</html>