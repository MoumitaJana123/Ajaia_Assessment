<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Dashboard - Ajaia Portal</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-gray-50">
  <nav class="bg-white shadow p-4 flex justify-between items-center px-8">
    <h1 class="text-xl font-bold">Ajaia Document Portal</h1>
    <div class="flex items-center space-x-4">
      <span class="text-gray-600">Logged in as: <b><%= user.name %></b></span>
      <a href="/auth/logout" class="text-red-500 hover:underline">Logout</a>
    </div>
  </nav>

  <div class="max-w-4xl mx-auto mt-8 p-6">
    <div class="flex justify-between items-center mb-6">
      <form action="/documents/create" method="POST">
        <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded shadow hover:bg-blue-700">+ New Document</button>
      </form>
      
      <form action="/documents/upload" method="POST" enctype="multipart/form-data" class="flex items-center space-x-2">
        <input type="file" name="file" accept=".txt,.md" required class="text-sm">
        <button type="submit" class="bg-green-600 text-white px-3 py-2 rounded text-sm hover:bg-green-700">Upload & Import</button>
      </form>
    </div>

    <div class="bg-white rounded shadow p-6 mb-6">
      <h2 class="text-lg font-bold mb-4 text-gray-800">My Documents</h2>
      <% if (ownedDocs.length === 0) { %>
        <p class="text-gray-500 text-sm">No documents created yet.</p>
      <% } else { %>
        <ul>
          <% ownedDocs.forEach(doc => { %>
            <li class="py-2 border-b flex justify-between items-center">
              <a href="/documents/<%= doc._id %>" class="text-blue-600 font-medium hover:underline"><%= doc.title %></a>
              <span class="text-xs text-gray-400">Updated: <%= new Date(doc.updatedAt).toLocaleDateString() %></span>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>

    <div class="bg-white rounded shadow p-6">
      <h2 class="text-lg font-bold mb-4 text-gray-800">Shared With Me</h2>
      <% if (sharedDocs.length === 0) { %>
        <p class="text-gray-500 text-sm">No documents shared with you.</p>
      <% } else { %>
        <ul>
          <% sharedDocs.forEach(doc => { %>
            <li class="py-2 border-b flex justify-between items-center">
              <div>
                <a href="/documents/<%= doc._id %>" class="text-blue-600 font-medium hover:underline"><%= doc.title %></a>
                <span class="text-xs text-gray-500 ml-2">(Owner: <%= doc.owner ? doc.owner.email : 'Unknown' %>)</span>
              </div>
              <span class="text-xs bg-yellow-100 text-yellow-800 px-2 py-1 rounded">Shared</span>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>
  </div>
</body>
</html>